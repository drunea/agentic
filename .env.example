MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=agentic
MYSQL_USER=agentic
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

CHROMA_PERSIST_DIR=./chroma_data

# Optional. When a specialist fails several runs in a row (expired API key, Ollama down...),
# POST {"text": "..."} here. Slack incoming webhooks accept that as-is; for Discord append
# /slack to the webhook URL. Leave empty to only log it and show a banner on Stock Analysis.
ALERT_WEBHOOK_URL=

# Backend URL the Streamlit frontend calls — same repo .env, read by
# frontend/components/config.py.
FRONTEND_API_URL=http://localhost:8000/api/v1

# Financial Modeling Prep (https://site.financialmodelingprep.com) — required, everything else is optional
FMP_KEY=your-fmp-api-key
# Real, correct endpoints — only change if FMP ever moves them.
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_LEGACY_BASE_URL=https://financialmodelingprep.com/api

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) — 10Y Treasury yield for Risk Analysis
FRED_API_KEY=your-fred-api-key
FRED_BASE_URL=https://api.stlouisfed.org/fred/series/observations
# SEC EDGAR requires a contact email in the download User-Agent for RAG filing ingestion.
SEC_EDGAR_COMPANY_NAME=YourAppName
SEC_EDGAR_CONTACT_EMAIL=you@example.com

# Alpha Vantage (https://www.alphavantage.co/support/#api-key) — Free tier: 25 req/day — reserved, not yet used
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Finnhub (https://finnhub.io/) — Free tier: 60 calls/min — reserved, not yet used
FINNHUB_API_KEY=your-finnhub-api-key

# Roic.ai (https://www.roic.ai/api/docs/getting-started) — earnings call transcripts
ROICAI_API_KEY=your-roicai-api-key
ROICAI_BASE_URL=https://api.roic.ai/v3.0.0

# News API (https://newsapi.org/) — Free tier: 100 req/day, dev/test only
# (their ToS forbids production/commercial use on this plan) — optional market-news source
NEWS_API_KEY=your-newsapi-key
NEWS_API_BASE_URL=https://newsapi.org/v2

# GNews (https://gnews.io/) — Free tier: 100 req/day, non-commercial only
# (their ToS forbids production/commercial use on this plan) — optional market-news source
GNEWS_API_KEY=your-gnews-key
GNEWS_BASE_URL=https://gnews.io/api/v4

# Massive (https://massive.com/) — primary market-news source, 5 req/min
MASSIVE_API_KEY=your-massive-api-key
MASSIVE_BASE_URL=https://api.massive.com

# StockTwits (https://stocktwitsapi.com/api) — reserved, not yet used
STOCKTWIST_API_KEY=your-stocktwits-key

OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only needed if you switch any *_LLM_BACKEND below to "gemini".
GEMINI_API_KEY=your-gemini-api-key
# ============================================================
# Per-LLM-user configuration: every specialist that calls an LLM gets its
# OWN explicit backend + BOTH models here (Gemini and Ollama), not just
# whichever one is currently active — switching `{NAME}_LLM_BACKEND` alone
# is then always enough, with no risk of silently picking up an unintended
# model from a shared global default, or a stale/wrong-suffix variable.
# Only 5 of the 11 specialists (plus the orchestrator's own cross-signal
# step) call an LLM at all — the rest (data_collector, technical, risk,
# performance, earnings, financial_statements) are pure Python, no entry
# needed here. See llm.py::get_model for exactly how
# {NAME}_LLM_BACKEND/{NAME}_GEMINI_MODEL/{NAME}_OLLAMA_MODEL are resolved.
# Defaults below all use Ollama (no API key required to get started) —
# switch individual ones to "gemini" once GEMINI_API_KEY is set, for speed.
# ============================================================

# Technical fallback only (used if a future specialist is added here
# without its own entry yet) — not meant to be relied on day-to-day now
# that every current one is listed explicitly.
LLM_BACKEND=ollama
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_MODEL=qwen3.5-4b-16k

#1.Stock Analysis
# --- Orchestrator (cross-signal contradictions + top-level summary) ---
ORCHESTRATOR_LLM_BACKEND=ollama
ORCHESTRATOR_GEMINI_MODEL=gemini-3.6-flash
ORCHESTRATOR_OLLAMA_MODEL=qwen3.5-4b-16k

#2.Fundamental Deep Dive
# --- AFFO (REIT AFFO/FFO extraction from 10-K filings) ---
AFFO_LLM_BACKEND=ollama
AFFO_GEMINI_MODEL=gemini-3.6-flash
AFFO_OLLAMA_MODEL=qwen3.5-4b-16k

#3.Technical Charts
# No LLM — Technical is pure Python (pandas_ta indicators + threshold
# trend classification). Nothing to configure here.

#4.Sentiment & News
# --- Market News feed (global, no LLM) --- provider priority, left-to-right;
# falls back to the next one only when a provider actually errors, not just
# when it returns zero results for the moment.
MARKET_NEWS_PROVIDER_ORDER=massive,fmp,newsapi,gnews

# --- Sentiment (news headline tone synthesis) ---
SENTIMENT_LLM_BACKEND=ollama
SENTIMENT_GEMINI_MODEL=gemini-3.6-flash
SENTIMENT_OLLAMA_MODEL=qwen3.5-4b-16k
# --- Earnings Call Analysis (transcript tone / evasive statements) ---
EARNINGS_CALL_LLM_BACKEND=ollama
EARNINGS_CALL_GEMINI_MODEL=gemini-3.6-flash
EARNINGS_CALL_OLLAMA_MODEL=qwen3.5-4b-16k
# Transcript data source, same priority+fallback pattern as
# MARKET_NEWS_PROVIDER_ORDER above.
EARNINGS_CALL_PROVIDER_ORDER=roic,fmp

#5.Valuation
# --- Valuation (ratios/DCF/peers + SEC filing-excerpt interpretation) ---
VALUATION_LLM_BACKEND=ollama
VALUATION_GEMINI_MODEL=gemini-3.6-flash
VALUATION_OLLAMA_MODEL=qwen3.5-4b-16k

#6.Market Disruption
# --- Disruption (competitive-disruption read from headlines + score) ---
DISRUPTION_LLM_BACKEND=ollama
DISRUPTION_GEMINI_MODEL=gemini-3.6-flash
DISRUPTION_OLLAMA_MODEL=qwen3.5-4b-16k

#7.Earnings Comparison
# No LLM — surprise %/beat-streak/trend are pure arithmetic on numbers
# already fetched from FMP. Nothing to configure here.

#8.Risk Analysis
# No LLM — VaR/CVaR, Altman Z-Score, Piotroski F-Score are all deterministic.

#9.Performance & Backtesting
# No LLM — Sharpe/Sortino/returns/drawdown are all deterministic.
